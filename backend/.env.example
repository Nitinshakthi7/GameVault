PORT=5000
NODE_ENV=development
# Use a fresh database name, e.g. gamevault_v2
MONGODB_URI=mongodb://127.0.0.1:27017/gamevault_v2
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed for CORS (local split dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:5500
# rawg | mock  (defaults to rawg if RAWG_API_KEY is set, otherwise mock)
GAME_PROVIDER=mock
# Free key: https://rawg.io/apidocs
RAWG_API_KEY=
# Used to build password reset links
APP_URL=http://localhost:5173
# true = Express also serves ../frontend/dist (production single-origin deploy)
SERVE_FRONTEND=false
